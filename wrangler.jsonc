// Hosting: Cloudflare Pages (akun Evolution), project "evo-song-manager".
// Yang disajikan HANYA folder web/ — file lain di repo (sync/, db/, dokumen) tidak ikut online.
// _redirects di web/ mengatur link vokalis /v/<kode> dan player /v/<kode>/play/<n>.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "evo-song-manager",
  "compatibility_date": "2026-11-04",
  "pages_build_output_dir": "web",
  // Bucket audio M4A untuk player (endpoint functions/audio/...). Bukan untuk WAV.
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "evo-audio" }]
}
