// Hosting: Cloudflare Workers (static assets). Situs = isi folder web/, tanpa build.
// _redirects di web/ mengatur link vokalis /v/<kode> dan player /v/<kode>/play/<n>.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fc-song-manager",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  "assets": { "directory": "web" }
}
